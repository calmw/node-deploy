# =============================================================================
# Ethereum L1 Sepolia 节点（Geth + Lighthouse · 省磁盘）
#
# 应用配置后重启：
#   docker compose down && docker compose up -d
#
# Tailscale IP：
#   tailscale ip -4
# =============================================================================

# 执行层 / 共识层镜像
GETH_IMAGE=ethereum/client-go:stable
LIGHTHOUSE_IMAGE=sigp/lighthouse:latest

# 同步模式（二选一）：
#   snapshot - ethPandaOps Geth 快照 + 历史裁剪（默认，推荐）
#   snap     - 纯网络 snap 同步（无需预下载，首 sync 慢，磁盘仍会较大）
SEPOLIA_SYNC_MODE=snapshot

# Geth 历史保留（仅保留近期 blocks / 不保留旧 tx / 关闭 logs 索引）
HISTORY_BLOCKS=360000
HISTORY_TRANSACTIONS=0

# 快照下载：0=curl 流式（默认，省磁盘）；1=aria2c 先下压缩包（需额外 ~687GB）
SNAPSHOT_USE_ARIA2=0

# Lighthouse checkpoint sync
CHECKPOINT_SYNC_URL=https://checkpoint-sync.sepolia.ethpandaops.io

# --- P2P ---
P2P_PORT=30303
CL_P2P_PORT=9000

# --- 容器内存（按物理内存调整）---
MEM_LIMIT=16g
MEMSWAP_LIMIT=24g
MEM_RESERVATION=8g
CL_MEM_LIMIT=8g

# --- Geth 性能 ---
CACHE_MB=4096
MAX_PEERS=50

# --- RPC（Tailscale 内网；勿对公网暴露）---
HTTP_BIND_ADDR=127.0.0.1
WS_BIND_ADDR=127.0.0.1
HTTP_VHOSTS=localhost,127.0.0.1
HTTP_PORT=8545
WS_PORT=8546

# Beacon REST API（Base / Prysm 等 L2 共识客户端需要）
BEACON_BIND_ADDR=127.0.0.1
BEACON_PORT=5052
