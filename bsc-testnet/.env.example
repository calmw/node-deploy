# =============================================================================
# BSC Chapel 测试网（Chain ID 97）
#
# 与 bsc-node 主网同机部署时端口已错开，见 README「同机部署」。
# =============================================================================

BSC_IMAGE=ghcr.io/bnb-chain/bsc:1.7.3

# 同步模式：
#   snap     - 从网络 snap 同步（默认，测试网推荐，无需预下载快照）
#   fast     - 48Club 快照（仅主网，勿在测试网使用）
#   pruned   - 官方 testnet 裁剪快照 ~180GB，见 bnb-chain/bsc-snapshots
BSC_SYNC_MODE=snap

NAT_MODE=any
P2P_PORT=30311

CACHE_MB=2048
TRIES_IN_MEMORY=8192
HISTORY_STATE=8192

MEM_LIMIT=16g
MEMSWAP_LIMIT=24g
MEM_RESERVATION=8g

MAX_PEERS=80
MAX_PEND_PEERS=100

# 测试网官方 RPC 端口 8575/8576（主网为 8545/8546，同 IP 不冲突）
HTTP_BIND_ADDR=127.0.0.1
WS_BIND_ADDR=127.0.0.1
HTTP_VHOSTS=localhost,127.0.0.1
HTTP_PORT=8575
WS_PORT=8576
METRICS_PORT=16060

# 测试网 StaticNodes 在 config.toml；一般无需覆盖
# BSC_BOOTNODES=
