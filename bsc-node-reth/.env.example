# =============================================================================
# BSC 主网 Reth 节点（bnb-reth / reth-bsc）
#
# 独立机器部署；自定义裁剪保留约 1.5 年 state（非 --full 默认 ~1 小时窗口）。
# 覆盖 .env 后: docker compose down && docker compose up -d
# Tailscale: tailscale ip -4
# =============================================================================

# 镜像: https://github.com/bnb-chain/reth-bsc/pkgs/container/bsc-reth
# 生产建议固定 digest 或版本 tag，勿盲目追 latest
RETH_IMAGE=ghcr.io/bnb-chain/bsc-reth:latest

# --- 裁剪窗口 ---
# 按块数保留历史（Reth distance = 保留最近 N+1 块）
# 1.5 年 @ 0.45s/块 ≈ 105_120_000；默认略留余量
PRUNE_HISTORY_DISTANCE=106500000
# 若改天数，setup.sh 会按 BLOCK_TIME_SEC 重算（需 re-run setup.sh）
# PRUNE_HISTORY_DAYS=548
BLOCK_TIME_SEC=0.45

# --- 数据目录（容器内 /data）---
RETH_DATADIR=/data

# --- 官方 Reth Full 快照（约 3.23 TiB，解压进 data/reth/）---
# 列表: https://github.com/bnb-chain/bsc-snapshots#source-4-bsc-reth-snapshots
RETH_SNAPSHOT_URL=https://pub-c5400abe5bed4adbaf8cd47467747e74.r2.dev/20260902_mainnet_reth_mdbx_full_node_v2.tar.zst

# --- NAT / P2P ---
NAT_MODE=any
P2P_PORT=30303
# NAT_MODE=extip 时填写
# NAT_EXTIP=

MAX_PEERS=100

# BSC 主网 trusted peers（逗号分隔 enode，留空则用 start.sh 内置）
# RETH_TRUSTED_PEERS=

# --- RPC（Tailscale 内网）---
HTTP_BIND_ADDR=127.0.0.1
WS_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
METRICS_PORT=6060

# --- 容器内存（Reth 主网建议 ≥32G 物理内存）---
MEM_LIMIT=32g
MEMSWAP_LIMIT=48g
MEM_RESERVATION=16g
