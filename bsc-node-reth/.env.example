# =============================================================================
# BSC 主网 Reth（源码镜像 + 创世同步 + 1.5 年 state 裁剪 + debug RPC）
#
# 覆盖 .env 后: docker compose down && docker compose up -d
# Tailscale: tailscale ip -4
# =============================================================================

# --- 镜像（本地构建后由 build-from-source.sh --update-env 写入）---
RETH_IMAGE=bsc-reth-local:latest

# 构建并推送远程仓库（需 docker login），例: ghcr.io/<user>/bsc-reth
RETH_LOCAL_IMAGE=bsc-reth-local
# RETH_REGISTRY=ghcr.io/yourorg/bsc-reth
# RETH_BSC_REF=v0.1.2

# 本地/自建镜像时不要 pull 官方 GHCR
RETH_COMPOSE_PULL=false

# --- 同步方式 ---
# genesis  = 不下载快照，从 block 0 同步（首 sync 需数周，4TB 需监控）
# snapshot = 使用 RETH_SNAPSHOT_URL 预下载
RETH_SYNC_MODE=genesis

# --- 裁剪（1.5 年 @ 0.45s/块）---
PRUNE_HISTORY_DISTANCE=106500000
# PRUNE_HISTORY_DAYS=548
BLOCK_TIME_SEC=0.45

RETH_DATADIR=/data

# 仅 RETH_SYNC_MODE=snapshot 时使用
RETH_SNAPSHOT_URL=https://pub-c5400abe5bed4adbaf8cd47467747e74.r2.dev/20260902_mainnet_reth_mdbx_full_node_v2.tar.zst

# --- Debug ---
RETH_DEBUG=true
# RUST_LOG=info,reth=debug,reth_bsc=debug
RETH_LOG_VERBOSITY=debug
HTTP_API=eth,net,web3,txpool,debug,trace,admin,rpc,reth,ots
WS_API=eth,net,web3,txpool,debug,trace

# --- NAT / P2P ---
NAT_MODE=any
P2P_PORT=30303
MAX_PEERS=100

HTTP_BIND_ADDR=127.0.0.1
WS_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
METRICS_PORT=6060

MEM_LIMIT=32g
MEMSWAP_LIMIT=48g
MEM_RESERVATION=16g
