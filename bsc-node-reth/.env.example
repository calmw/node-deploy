# =============================================================================
# BSC 主网 Reth（源码镜像 + 创世同步 + 静态 18 个月 / state 17 个月裁剪 + debug RPC）
#
# 覆盖 .env 后: docker compose down && docker compose up -d
# Tailscale: tailscale ip -4
# =============================================================================

# --- 镜像（本地构建后由 build-from-source.sh --update-env 写入）---
RETH_IMAGE=bsc-reth-local:latest

# 构建并推送远程仓库（需 docker login），例: ghcr.io/<user>/bsc-reth
RETH_LOCAL_IMAGE=bsc-reth-local
# RETH_REGISTRY=ghcr.io/yourorg/bsc-reth
# RETH_BSC_REF=v0.1.2

# 本地/自建镜像时不要 pull 官方 GHCR
RETH_COMPOSE_PULL=false

# --- 同步方式 ---
# genesis  = 不下载快照，从 block 0 同步（首 sync 需数周，4TB 需监控）
# snapshot = 使用 RETH_SNAPSHOT_URL 预下载
RETH_SYNC_MODE=genesis

# --- 裁剪（按 BSC 当前出块间隔 0.45s 换算块数；改后 bash scripts/setup.sh init）---
# 交易 / 回执 / 交易哈希索引 / sender：18 个月 ≈ 105192000 块
PRUNE_STATIC_HISTORY_MONTHS=18
# state 历史（账户 / 存储）：17 个月 ≈ 99348000 块
PRUNE_STATE_HISTORY_MONTHS=17
BLOCK_TIME_SEC=0.45
# 直接指定块数（优先于月数）:
# PRUNE_STATIC_HISTORY_DISTANCE=105192000
# PRUNE_STATE_HISTORY_DISTANCE=99348000

RETH_DATADIR=/data

# 仅较新 reth-bsc 支持，v0.1.2 留空即可，例:
# RETH_NODE_EXTRA_ARGS="--enable-prefetch --optimize.enable-execution-cache"

# 仅 RETH_SYNC_MODE=snapshot 时使用
RETH_SNAPSHOT_URL=https://pub-c5400abe5bed4adbaf8cd47467747e74.r2.dev/20260902_mainnet_reth_mdbx_full_node_v2.tar.zst

# --- Debug / 日志 ---
# 创世同步建议 false，避免 FCU/debug 刷屏；排查问题时改为 true
RETH_DEBUG=false
RUST_LOG=info,reth=info,reth_bsc=info
# 默认不写盘，只看: docker compose logs -f reth
# 若需文件日志: RETH_LOG_FILE_DIR=/data/logs
# 深度排查: RETH_DEBUG=true 且 RUST_LOG=info,reth=debug,reth_bsc=debug
HTTP_API=eth,net,web3,txpool,debug,trace,admin,rpc,reth,ots
WS_API=eth,net,web3,txpool,debug,trace

# --- NAT / P2P ---
# 内网机器 any 可能宣告 0.0.0.0，需 NAT_MODE=extip + NAT_EXTIP=<公网IP>，路由器转发 30303 tcp/udp
# 家宽动态 IP：cron 定时跑 scripts/update-extip.sh 自动更新 NAT_EXTIP
NAT_MODE=any
# NAT_EXTIP=
P2P_PORT=30303
MAX_PEERS=100

HTTP_BIND_ADDR=127.0.0.1
WS_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
METRICS_PORT=6060

MEM_LIMIT=32g
MEMSWAP_LIMIT=48g
MEM_RESERVATION=16g
