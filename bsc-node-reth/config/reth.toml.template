# BSC Reth 自定义裁剪（由 setup.sh 渲染，勿手改 data/reth/reth.toml）
#   静态数据（交易 / 回执 / 交易哈希索引）:          最近 18 个月（sender 全部裁掉）
#   state 历史（账户 / 存储历史）:                   最近 17 个月
# 距离按 BSC 当前出块间隔 0.45s（Fermi 硬分叉后）换算为块数。
# 勿使用 --full；首启前必须存在此文件于 datadir。
# 参考: https://reth.rs/run/configuration/#the-prune-section

[prune]
block_interval = 5

[prune.segments]
# 保留最近 N+1 块
# 静态数据：N = PRUNE_STATIC_HISTORY_DISTANCE（默认 105_192_000 ≈ 18 个月 @ 0.45s/块）
bodies_history = { distance = __PRUNE_STATIC_DISTANCE__ }
receipts = { distance = __PRUNE_STATIC_DISTANCE__ }
transaction_lookup = { distance = __PRUNE_STATIC_DISTANCE__ }
# 官方 Full 快照已全部裁掉 sender，需保持一致；RPC 需要时从签名实时恢复
sender_recovery = "full"

# state 历史：N = PRUNE_STATE_HISTORY_DISTANCE（默认 99_348_000 ≈ 17 个月 @ 0.45s/块）
account_history = { distance = __PRUNE_STATE_DISTANCE__ }
storage_history = { distance = __PRUNE_STATE_DISTANCE__ }

# 仅影响 pipeline 批量追块（创世同步 / 长时间落后）；追上链头后逐块执行不受影响。
# 加大单批 state 变更数以减少提交次数（默认 max_changes=5_000_000、max_cumulative_gas=1.5T），
# 代价是攒批期间多占几 GB 内存。
[stages.execution]
max_blocks = 500000
max_changes = 20000000
max_cumulative_gas = 6000000000000
max_duration = "10m"
